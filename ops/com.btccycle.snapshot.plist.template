<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.btccycle.snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/ops/run_btc_cycle.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- 09:10 local, ten minutes after a sibling tracker's job, so the two Discord
         posts do not land in the same second and the logs stay readable if
         both fail on the same network blip. No jitter: this hits public
         exchange APIs where a predictable daily timestamp makes the price
         series cleaner, same reasoning as that sibling's plist. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
